# ============================================================
# MyStudyApp Backend — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here

DEBUG=False

# Comma-separated list of allowed hostnames/IPs (no spaces)
# Production: use the deployed backend hostname (no protocol).
ALLOWED_HOSTS=mystudyapp-backend-five.vercel.app

# ── Database ──────────────────────────────────────────────────
# SQLite (development only — not for production)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# PostgreSQL (production — uncomment and fill in)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=mystudyapp_db
# DATABASE_USER=mystudyapp_user
# DATABASE_PASSWORD=changeme_secure_password
# DATABASE_HOST=db
# DATABASE_PORT=5432

# ── CORS / Frontend ───────────────────────────────────────────
# Comma-separated list of trusted frontend origins
# Production frontend origin (include any custom domains here as well).
CORS_ALLOWED_ORIGINS=https://mystudyapp-frontend.vercel.app

# ── Admin Dashboard ───────────────────────────────────────────
# Password used by the custom admin gate (separate from Django admin)
ADMIN_DASHBOARD_PASSWORD=changeme_admin_password_here

# ── JWT Settings ──────────────────────────────────────────────
# Token lifetimes in days
ACCESS_TOKEN_LIFETIME_DAYS=1
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email (optional — for future password-reset flows) ────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@mystudyapp.com
# EMAIL_HOST_PASSWORD=your_email_password
# DEFAULT_FROM_EMAIL=MyStudyApp <noreply@mystudyapp.com>
# Frontend URL used in password reset links
FRONTEND_URL=https://mystudyapp-frontend.vercel.app
